# Pooled connection (port 6543) - used by the app at runtime. Must include
# ?pgbouncer=true or Prisma's prepared statements break against the pooler.
DATABASE_URL=

# Direct connection (port 5432, no "pooler" in the host) - used only for
# schema changes (prisma db push / migrate). Not used at runtime.
DIRECT_URL=

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_APP_URL=http://localhost:3000
